#pragma once
#include "age.asli"

namespace gist
{
	gist_data
	load_data()
	{
		return load<gist_data>(static_buffer, GIST_DATA_OFFSET);
	}

	gist_lut_data
	load_lut_data()
	{
		return load<gist_lut_data>(static_buffer, GIST_LUT_DATA_OFFSET);
	}

	bool
	enabled()
	{
		return ddgi_enabled_and_extra & (1u << 2u);
	}

	// focal_px * (r / depth) => px
	float
	focal_px()
	{
		return float(backbuffer_size.y) * 0.5f / tan_fov_y_half;
	}

	float
	specular_hit_dist_max(const in gist_data data)
	{
		// todo,
		// px_threshold = (max_cam_speed(m/frame) / hit_dist_max) * focal_px
		// hit_dist_max = max_cam_speed(m/frame) * focal_px / px_threshold
		// focal_px = extent.height * 0.5f / tan(fov_y * 0.5f)
		// focal_px * (r / depth) => px
		return 10000.f;
	}

	float
	specular_roughness_max(const in gist_data data)
	{
		// above this : split_sum fallback from diffuse irradiance
		return 0.4f;
	}

	uint32
	specular_age_max(const in gist_data data, float roughness)
	{
		return uint32(round(lerp(1.f, 32.f, saturate(roughness / specular_roughness_max(data)))));
	}

	float3
	calc_cell_origin(const in gist_lut_data lut_data)
	{
		return round(gi_origin / lut_data.cell_size_arr[0]) * lut_data.cell_size_arr[0];
	}

	float3
	calc_cube_min(const in gist_lut_data lut_data, uint32 layer)
	{
		return calc_cell_origin(lut_data) - lut_data.layer_boundary_arr[layer];
	}

	uint32
	calc_layer(const in gist_data data, const in gist_lut_data lut_data, const float3 world_pos)
	{
		const float3 rel  = world_pos - calc_cell_origin(lut_data);
		const float	 axis = max(abs(rel));

		// expand_all()

		for (uint32 i = 0; i < data.outer_layer_count(); ++i)
		{
			if (axis <= lut_data.layer_boundary_arr[i])
			{
				return i;
			}
		}

		return data.outer_layer_count();
	}

	float
	calc_cell_size(const in gist_data data, const in gist_lut_data lut_data, const float3 position)
	{
		return lut_data.cell_size_arr[calc_layer(data, lut_data, position)];
	}

	half
	calc_cell_surfel_radius(const in gist_data data, const in gist_lut_data lut_data, const float3 position)
	{
		return cast<half>(calc_cell_size(data, lut_data, position) * GIST_CELL_SURFEL_RADIUS_RATIO);
	}

	float3
	calc_region(float3 xyz, out int32 region)
	{
		const float3 xyz_abs = abs(xyz);
		float3		 xyz_res = (float3)0;

		if (xyz_abs.x >= xyz_abs.y and xyz_abs.x >= xyz_abs.z)
		{
			if (xyz.x > 0)
			{
				xyz_res.x = -xyz.z;
				xyz_res.y = xyz.y;
				xyz_res.z = xyz.x;
				region	  = 1;
			}
			else
			{
				xyz_res.x = xyz.z;
				xyz_res.y = xyz.y;
				xyz_res.z = -xyz.x;
				region	  = 2;
			}
		}
		else if (xyz_abs.y >= xyz_abs.x and xyz_abs.y >= xyz_abs.z)
		{
			if (xyz.y > 0)
			{
				xyz_res.x = xyz.x;
				xyz_res.y = -xyz.z;
				xyz_res.z = xyz.y;
				region	  = 3;
			}
			else
			{
				xyz_res.x = xyz.x;
				xyz_res.y = xyz.z;
				xyz_res.z = -xyz.y;
				region	  = 4;
			}
		}
		else
		{
			if (xyz.z > 0)
			{
				xyz_res.x = xyz.x;
				xyz_res.y = xyz.y;
				xyz_res.z = xyz.z;
				region	  = 5;
			}
			else
			{
				xyz_res.x = -xyz.x;
				xyz_res.y = xyz.y;
				xyz_res.z = -xyz.z;
				region	  = 6;
			}
		}

		return xyz_res;
	}

	bool
	calc_sphere_cell_intersect(const in gist_data data, const in gist_lut_data lut_data, float3 position, float3 normal, float radius, int32_4 cell_idx)
	{
		const float3 rel	= position - calc_cell_origin(lut_data);
		const int32	 region = cell_idx.w;

		if (region == 0)
		{
			const float	 cell_size = lut_data.cell_size_arr[0];
			const float3 cell_min  = cell_idx.xyz * cell_size;
			const float3 cell_max  = cell_min + cell_size;

			return hemisphere_aabb_intersect(rel, normal, radius, cell_min, cell_max, radius * 0.1f);
		}
		else
		{
			const int32 layer = cell_idx.z;
			const float min_z = lut_data.layer_boundary_arr[layer - 1];
			const float max_z = lut_data.layer_boundary_arr[layer];

			int32_3 cell_idx_world = cell_idx.xyz;

			const float cell_size_near_uv = min_z * 2.f / data.cell_count_per_axis();
			const float cell_size_far_uv  = max_z * 2.f / data.cell_count_per_axis();

			float3 cell_near_low;
			float3 cell_near_high;
			float3 cell_far_low;
			float3 cell_far_high;

			// maybe there are better ways to do this, but i can't think of one
			if (region == 1)
			{
				cell_near_low.yz = float2(cell_idx.y, -cell_idx.x) * cell_size_near_uv;
				cell_near_low.x	 = min_z;
				cell_far_low.yz	 = float2(cell_idx.y, -cell_idx.x) * cell_size_far_uv;
				cell_far_low.x	 = max_z;

				cell_near_high.yz = float2(cell_idx.y + 1, -cell_idx.x - 1) * cell_size_near_uv;
				cell_near_high.x  = min_z;
				cell_far_high.yz  = float2(cell_idx.y + 1, -cell_idx.x - 1) * cell_size_far_uv;
				cell_far_high.x	  = max_z;
			}
			else if (region == 2)
			{
				cell_near_low.yz = float2(cell_idx.y, cell_idx.x) * cell_size_near_uv;
				cell_near_low.x	 = -min_z;
				cell_far_low.yz	 = float2(cell_idx.y, cell_idx.x) * cell_size_far_uv;
				cell_far_low.x	 = -max_z;

				cell_near_high.yz = float2(cell_idx.y + 1, cell_idx.x + 1) * cell_size_near_uv;
				cell_near_high.x  = -min_z;
				cell_far_high.yz  = float2(cell_idx.y + 1, cell_idx.x + 1) * cell_size_far_uv;
				cell_far_high.x	  = -max_z;
			}
			else if (region == 3)
			{
				cell_near_low.xz = float2(cell_idx.x, -cell_idx.y /*- 1*/) * cell_size_near_uv;
				cell_near_low.y	 = min_z;
				cell_far_low.xz	 = float2(cell_idx.x, -cell_idx.y /*- 1*/) * cell_size_far_uv;
				cell_far_low.y	 = max_z;

				cell_near_high.xz = float2(cell_idx.x + 1, -cell_idx.y - 1) * cell_size_near_uv;
				cell_near_high.y  = min_z;
				cell_far_high.xz  = float2(cell_idx.x + 1, -cell_idx.y - 1) * cell_size_far_uv;
				cell_far_high.y	  = max_z;
			}
			else if (region == 4)
			{
				cell_near_low.xz = float2(cell_idx.x, cell_idx.y) * cell_size_near_uv;
				cell_near_low.y	 = -min_z;
				cell_far_low.xz	 = float2(cell_idx.x, cell_idx.y) * cell_size_far_uv;
				cell_far_low.y	 = -max_z;

				cell_near_high.xz = float2(cell_idx.x + 1, cell_idx.y + 1) * cell_size_near_uv;
				cell_near_high.y  = -min_z;
				cell_far_high.xz  = float2(cell_idx.x + 1, cell_idx.y + 1) * cell_size_far_uv;
				cell_far_high.y	  = -max_z;
			}
			else if (region == 5)
			{
				cell_near_low.xy = float2(cell_idx.x, cell_idx.y) * cell_size_near_uv;
				cell_near_low.z	 = min_z;
				cell_far_low.xy	 = float2(cell_idx.x, cell_idx.y) * cell_size_far_uv;
				cell_far_low.z	 = max_z;

				cell_near_high.xy = float2(cell_idx.x + 1, cell_idx.y + 1) * cell_size_near_uv;
				cell_near_high.z  = min_z;
				cell_far_high.xy  = float2(cell_idx.x + 1, cell_idx.y + 1) * cell_size_far_uv;
				cell_far_high.z	  = max_z;
			}
			else
			{
				// region == 6
				cell_near_low.xy = float2(-cell_idx.x /* - 1*/, cell_idx.y) * cell_size_near_uv;
				cell_near_low.z	 = -min_z;
				cell_far_low.xy	 = float2(-cell_idx.x /* - 1*/, cell_idx.y) * cell_size_far_uv;
				cell_far_low.z	 = -max_z;

				cell_near_high.xy = float2(-cell_idx.x - 1, cell_idx.y + 1) * cell_size_near_uv;
				cell_near_high.z  = -min_z;
				cell_far_high.xy  = float2(-cell_idx.x - 1, cell_idx.y + 1) * cell_size_far_uv;
				cell_far_high.z	  = -max_z;
			}

			return hemisphere_aabb_intersect(rel, normal, radius,
											 min(cell_near_low, cell_near_high, cell_far_low, cell_far_high),
											 max(cell_near_low, cell_near_high, cell_far_low, cell_far_high),
											 radius * 0.1f);
		}
	}

	bool
	calc_surfel_cell_intersect(const in gist_data data, const in gist_lut_data lut_data, const gist_cell_surfel surfel, int32_4 cell_idx)
	{
		return calc_sphere_cell_intersect(data, lut_data, surfel.position, decode_oct_snorm16(surfel.normal_oct_snorm16), surfel.radius, cell_idx);
	}

	uint32
	calc_atlas_tile_local_idx(const float3 local_dir)
	{
		assert(local_dir.y >= 0.f, line, local_dir);
		const float2 oct_uv = encode_world_hemi_octahedral(local_dir);							// [-1, 1]
		int32_2		 idx	= int32_2(floor((oct_uv * 0.5f + 0.5f) * GIST_ATLAS_TILE_SIZE));	// [0, 6)
		idx					= min(idx, GIST_ATLAS_TILE_SIZE - 1);
		return idx.x + idx.y * GIST_ATLAS_TILE_SIZE;
	}
}	 // namespace gist

