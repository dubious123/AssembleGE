#pragma once
#include "age.asli"

float3
get_random_color(uint32 index)
{
	index  = (index ^ 61) ^ (index >> 16);
	index *= 9;
	index  = index ^ (index >> 4);
	index *= 0x27d4eb2d;
	index  = index ^ (index >> 15);

	float3 raw_color = float3(
		(float)((index >> 0) & 0xFF) / 255.0f,
		(float)((index >> 8) & 0xFF) / 255.0f,
		(float)((index >> 16) & 0xFF) / 255.0f);

	return raw_color * 0.8f + 0.2f;
}

float
calc_screen_space_contact_shadow(texture_2d<float> depth_buffer, vertex_fat v, float3 world_pos, float3 world_to_light_dir /*normalized*/)
{
	static const uint32 num_steps		 = 32;
	static const float	max_ray_distance = 1.f;
	static const float	thickness		 = 0.5f;
	static const float	step_size		 = max_ray_distance / float(num_steps);

	const float2 pixel_xy = v.pos.xy;

	float3 ray_pos	= world_pos + world_to_light_dir * step_size * interleaved_gradient_noise(pixel_xy);
	float  occluded = 1.0f;

	expand_all()

	for (auto i = 0u; i < num_steps; i++)
	{
		ray_pos += world_to_light_dir * step_size;

		const float4 clip = mul(view_proj, float4(ray_pos, 1.0f));
		if (clip.w <= 0.0f)
		{
			break;	  // behind camera
		}

		const float3 ndc = clip.xyz / clip.w;

		if (any(abs(ndc.xy) > 1.0f))
		{
			break;
		}

		const float2 uv = ndc.xy * float2(0.5f, -0.5f) + 0.5f;

		float screen_depth = sample_level(depth_buffer, get_point_clamp_sampler(), uv, 0);
		float ray_depth	   = ndc.z;

		float depth_diff = screen_depth - ray_depth;

		if (depth_diff > 0.0f)
		{
			float linear_diff = calc_linear_depth(screen_depth, cam_near_z) - calc_linear_depth(ray_depth, cam_near_z);

			if (linear_diff < thickness)
			{
				occluded = 0.0f;
				break;
			}
		}
	}

	return occluded;
}

float3
calc_blinn_phong_directional_light_color(directional_light light, float3 surface_normal, float3 view_dir)
{
	const float3 surface_to_light = -light.direction;
	const float3 half_dir		  = normalize(surface_to_light + view_dir);

	const float diffuse	  = saturate(dot(surface_normal, surface_to_light));
	float		specular  = saturate(dot(surface_normal, half_dir));
	specular			 *= specular;	 // 2
	specular			 *= specular;	 // 4
	specular			 *= specular;	 // 8
	specular			 *= specular;	 // 16
	specular			 *= specular;	 // 32
	specular			 *= specular;	 // 64

	return light.color * light.intensity * (diffuse + specular);
}

float3
calc_blinn_phong_light_color(unified_light light, float3 surface_pos, float3 surface_normal, float3 view_dir)
{
	const float3 surface_to_light = light.position - surface_pos;
	const float	 distance		  = length(surface_to_light);

	// if (light.range < distance)
	//{
	//     return float3(0, 0, 0);
	// }

	const float3 color	   = cast<float3>(light.color);
	const float	 intensity = light.intensity;
	const float3 dir	   = cast<float3>(light.direction);
	const float	 cos_inner = light.cos_inner;
	const float	 cos_outer = light.cos_outer;

	const float3 surface_to_light_dir = surface_to_light / distance;
	const float	 cos_angle			  = dot(-surface_to_light_dir, dir);

	const float3 half_dir = normalize(surface_to_light_dir + view_dir);

	const float diffuse	  = saturate(dot(surface_normal, surface_to_light_dir));
	float		specular  = saturate(dot(surface_normal, half_dir));
	specular			 *= specular;	 // 2
	specular			 *= specular;	 // 4
	specular			 *= specular;	 // 8
	specular			 *= specular;	 // 16
	specular			 *= specular;	 // 32
	specular			 *= specular;	 // 64

	const float distance_ratio = distance / light.range;
	const float window		   = saturate(1.0 - distance_ratio * distance_ratio);
	const float attenuation	   = 1.0 / max(distance * distance, epsilon_1e4) * window * window;

	const float cone_falloff = saturate((cos_angle - cos_outer) / (cos_inner - cos_outer));

	return color * intensity * (diffuse + specular) * attenuation * cone_falloff * cone_falloff;
}

float3
calc_directional_light(directional_light light, float3 vertex_normal, float3 world_to_cam_dir)
{
	return calc_blinn_phong_directional_light_color(light, vertex_normal, world_to_cam_dir);
}

float3
calc_directional_shadow_rt(directional_light light, float3 world_pos, float3 face_normal)
{
	const bool cast_shadow = get_bit(light.cast_shadow_and_extra, 0);

	if (cast_shadow is_false)
	{
		return float3(1, 1, 1);
	}

	const float n_dot_l = dot(face_normal, -light.direction);
	if (n_dot_l <= 0.0f)
	{
		return zero<float3>();
	}

	const float3 transmittance = rt::trace_transmittance(
		rt::init_ray_desc(surface_offset(world_pos, face_normal), -light.direction, 0.f, float_max));

	return transmittance;
}

float3
calc_unified_light(unified_light light, float3 world_pos, float3 vertex_normal, float3 world_to_cam_dir)
{
	return calc_blinn_phong_light_color(light, world_pos, vertex_normal, world_to_cam_dir);
}

float3
calc_unified_shadow_rt(unified_light light, float3 world_pos, float3 face_normal)
{
	const bool cast_shadow = get_bit(light.cast_shadow_and_extra, 0);

	if (cast_shadow is_false)
	{
		return float3(1, 1, 1);
	}

	const float3 world_to_light = light.position - world_pos;
	const float	 n_dot_l		= dot(face_normal, world_to_light);
	if (n_dot_l <= 0.0f)
	{
		return zero<float3>();
	}

	const float	 world_to_light_len = length(world_to_light);
	const float3 world_to_light_dir = world_to_light / max(world_to_light_len, epsilon_1e6);

	const float3 transmittance = rt::trace_transmittance(
		rt::init_ray_desc(surface_offset(world_pos, face_normal), world_to_light_dir, 0.f, world_to_light_len));

	return transmittance;
}

float3
calc_pbr_light(const in pbr_surface_data surface_data, unified_light light)
{
	const float3 surface_to_light = light.position - surface_data.world_pos;
	const float	 distance		  = length(surface_to_light);
	const float3 world_to_light	  = surface_to_light / distance;

	const float n_dot_l = dot(surface_data.normal, world_to_light);
	if (n_dot_l <= 0.f)
	{
		return zero<float3>();
	}

	const float distance_ratio = distance / light.range;
	const float window		   = saturate(1.f - distance_ratio * distance_ratio);
	const float attenuation	   = window * window / max(distance * distance, epsilon_1e4);

	const float cos_angle	 = dot(-world_to_light, cast<float3>(light.direction));
	const float cone_falloff = saturate((cos_angle - light.cos_outer) / (light.cos_inner - light.cos_outer));

	const float3 light_radiance = cast<float3>(light.color) * light.intensity
								* attenuation * cone_falloff * cone_falloff;

	// soft terminator: kill normal-mapped light where the geometry faces away
	const float visibility = saturate(dot(surface_data.vertex_normal, world_to_light) * 10);
	return brdf::eval_punctual(surface_data, world_to_light, saturate(n_dot_l)) * light_radiance * visibility;
}

float3
calc_pbr_light(const in pbr_surface_data surface_data, directional_light light)
{
	const float3 world_to_light = -light.direction;

	const float n_dot_l = dot(surface_data.normal, world_to_light);
	if (n_dot_l <= 0.f)
	{
		return zero<float3>();
	}

	const float3 light_radiance = light.color * light.intensity;

	// soft terminator: kill normal-mapped light where the geometry faces away
	const float visibility = saturate(dot(surface_data.vertex_normal, world_to_light) * 10);
	return brdf::eval_punctual(surface_data, world_to_light, saturate(n_dot_l)) * light_radiance * visibility;
}

float3
calc_pbr_ibl_diffuse(const in pbr_surface_data surface_data, const env_light env)
{
	const float3 n = mul(env.rotation_mat, surface_data.normal);

	const float n_dot_v = surface_data.n_dot_v;

	const float3 fr				   = max(to_float3(1.f - surface_data.roughness), surface_data.f0);
	const float	 one_minus_n_dot_v = 1.f - n_dot_v;
	const float3 f				   = surface_data.f0 + (fr - surface_data.f0) * pow_5(one_minus_n_dot_v);

	texture_cube<float4> irradiance_tex = global_resource_buffer[env.irradiance_tex_id];

	const float3 irradiance = sample_level(irradiance_tex, get_linear_clamp_sampler(), n, 0).rgb;

	const float3 diffuse = (1.f - f) * surface_data.c_diffuse * irradiance;

	return diffuse * env.intensity * env.tint;
}

float3
calc_pbr_ibl_specular(const in pbr_surface_data surface_data, const env_light env)
{
	const float3 r = mul(env.rotation_mat, reflect(-surface_data.view, surface_data.normal));

	const float n_dot_v = surface_data.n_dot_v;

	texture_2d<float2>	 brdf_lut_tex  = global_resource_buffer[env_light_brdf_lut_id];
	texture_cube<float4> prefilter_tex = global_resource_buffer[env.prefilter_tex_id];

	const float mip = surface_data.roughness * (float(env.prefilter_mip_count) - 1);

	const float3 prefilter = sample_level(prefilter_tex, get_linear_clamp_sampler(), r, mip).rgb;

	const float2 brdf_lut_val = sample_level(brdf_lut_tex, get_linear_clamp_sampler(), float2(n_dot_v, surface_data.roughness), 0);

	const float3 specular = prefilter * (surface_data.f0 * brdf_lut_val.x + brdf_lut_val.y);

	return specular * env.intensity * env.tint;
}

float3
calc_pbr_gibs_specular(const in pbr_surface_data surface_data, const float3 gi_e)
{
	const float		   n_dot_v		= surface_data.n_dot_v;
	texture_2d<float2> brdf_lut_tex = global_resource_buffer[env_light_brdf_lut_id];

	const float2 brdf_lut_val = sample_level(brdf_lut_tex, get_linear_clamp_sampler(), float2(n_dot_v, surface_data.roughness), 0);

	const float3 prefilter = gi_e * pi_inv;
	return prefilter * (surface_data.f0 * brdf_lut_val.x + brdf_lut_val.y);
}

float3
calc_pbr_gist_specular(const in pbr_surface_data surface_data, const float3 gi_e)
{
	const float		   n_dot_v		= surface_data.n_dot_v;
	texture_2d<float2> brdf_lut_tex = global_resource_buffer[env_light_brdf_lut_id];

	const float2 brdf_lut_val = sample_level(brdf_lut_tex, get_linear_clamp_sampler(), float2(n_dot_v, surface_data.roughness), 0);

	const float3 prefilter = gi_e * pi_inv;
	return prefilter * (surface_data.f0 * brdf_lut_val.x + brdf_lut_val.y);
}

float3
calc_pbr_ibl(const in pbr_surface_data surface_data, const env_light env)
{
	const float3 diffuse  = calc_pbr_ibl_diffuse(surface_data, env);
	const float3 specular = calc_pbr_ibl_specular(surface_data, env);
	return (diffuse + specular) * surface_data.occlusion;
}

float3
calc_skybox_color(float3 dir /*normalized*/)
{
	float3 res = float3(0, 0, 0);

	expand(MAX_ENV_LIGHT)

	for (auto i = 0u; i < env_light_count; ++i)
	{
		const env_light env = load_env_light(i);

		texture_cube<float4> radiance = global_resource_buffer[env.radiance_tex_id];

		res += sample_level(radiance, get_linear_clamp_sampler(), mul(env.rotation_mat, dir), 0).rgb * float(env.intensity) * env.tint;
	}

	return res;
}

float3
calc_pbr_ddgi(const in pbr_surface_data surface_data, const in float3 world_face_normal)
{
	const float3 irradiance = sample_ddgi_irradiance(surface_data.world_pos, world_face_normal);
	return surface_data.c_diffuse * irradiance;
}

template <bool enable_wave_inst>
float3
calc_di(const in pbr_surface_data surface_data, const float3 world_face_normal)
{
	float3 res = zero<float3>();

	res += surface_data.emissive;

	const uint32 directional_light_count = directional_light_count_and_extra & 0xff;

	for (uint32 d = 0; d < directional_light_count; ++d)
	{
		const directional_light light = load_directional_light(d);

		res += calc_pbr_light(surface_data, light)
			 * calc_directional_shadow_rt(light, surface_data.world_pos, world_face_normal);
	}


	const uint32_3 light_bin_axis = world_to_light_bin_axis(surface_data.world_pos);

	const zbin_entry x_entry = load_bin_entry_x(light_bin_axis.x);
	const zbin_entry y_entry = load_bin_entry_y(light_bin_axis.y);
	const zbin_entry z_entry = load_bin_entry_z(light_bin_axis.z);

	const uint32 min_id = max(x_entry.min_idx, max(y_entry.min_idx, z_entry.min_idx));
	const uint32 max_id = min(x_entry.max_idx, min(y_entry.max_idx, z_entry.max_idx));

	const uint32 word_begin = enable_wave_inst ? wave_active_min(min_id) / 32 : min_id / 32;
	const uint32 word_end	= enable_wave_inst ? wave_active_max(max_id) / 32 : max_id / 32;

	for (uint32 w = word_begin; w <= word_end; ++w)
	{
		const uint32 x_mask	  = load_bin_mask_x(light_bin_axis.x, w);
		const uint32 y_mask	  = load_bin_mask_y(light_bin_axis.y, w);
		const uint32 z_mask	  = load_bin_mask_z(light_bin_axis.z, w);
		const uint32 bit_mask = x_mask & y_mask & z_mask;

		uint32 wave_bit_mask = enable_wave_inst ? wave_active_bit_or(bit_mask) : bit_mask;

		while (wave_bit_mask != 0)
		{
			const uint32 bit	   = first_bit_low(wave_bit_mask);
			const uint32 sorted_id = w * 32 + bit;
			// wave_bit_mask		   &= ~(1u << bit);
			wave_bit_mask &= (wave_bit_mask - 1u);

			if ((enable_wave_inst is_false) or (bit_mask & (1u << bit)))
			{
				const unified_light light = load_sorted_light(sorted_id);

				res += calc_pbr_light(surface_data, light)
					 * calc_unified_shadow_rt(light, surface_data.world_pos, world_face_normal);
			}
		}
	}

	return res;
}

float3
calc_gi(const in pbr_surface_data surface_data, float3 irradiance)
{
	float3		 gi	   = zero<float3>();
	const float3 f_avg = surface_data.f0 + (float3(1.f, 1.f, 1.f) - surface_data.f0) / 21;

	const float3 gi_diffuse	 = surface_data.c_diffuse * irradiance * pi_inv;
	gi						+= (1.f - f_avg) * gi_diffuse * surface_data.occlusion;

	{
		texture_2d<float2> brdf_lut_tex = global_resource_buffer[env_light_brdf_lut_id];

		const float2 brdf_lut_val = sample_level(brdf_lut_tex, get_linear_clamp_sampler(), float2(surface_data.n_dot_v, surface_data.roughness), 0);

		const float3 gi_specular = (irradiance * pi_inv) * (surface_data.f0 * brdf_lut_val.x + brdf_lut_val.y);

		gi += gi_specular;
	}


	return gi;
}

float3
calc_gi(const in pbr_surface_data surface_data, float3 irradiance, float3 specular_radiance)
{
	float3		 gi	   = zero<float3>();
	const float3 f_avg = surface_data.f0 + (float3(1.f, 1.f, 1.f) - surface_data.f0) / 21;

	const float3 gi_diffuse	 = surface_data.c_diffuse * irradiance * pi_inv;
	gi						+= (1.f - f_avg) * gi_diffuse * surface_data.occlusion;

	{
		texture_2d<float2> brdf_lut_tex = global_resource_buffer[env_light_brdf_lut_id];

		const float2 brdf_lut_val = sample_level(brdf_lut_tex, get_linear_clamp_sampler(), float2(surface_data.n_dot_v, surface_data.roughness), 0);

		gi += specular_radiance * (surface_data.f0 * brdf_lut_val.x + brdf_lut_val.y);
	}

	return gi;
}

namespace lighting
{
	namespace detail
	{
		struct gi_func
		{
			float3
			operator()(const in pbr_surface_data surface_data, const in float3 face_normal)
			{
				float3 ambient_light = zero<float3>();

				attr_branch()

				if (ddgi_enabled())
				{
					// todo need fresnel?
					// from https://google.github.io/filament/Filament.md.html
					c_auto f_avg = surface_data.f0 + (float3(1.f, 1.f, 1.f) - surface_data.f0) / 21;

					c_auto gi_diffuse  = calc_pbr_ddgi(surface_data, face_normal);
					ambient_light	  += (1.f - f_avg) * gi_diffuse * surface_data.occlusion;

					expand(MAX_ENV_LIGHT)

					for (auto i = 0u; i < env_light_count; ++i)
					{
						ambient_light += calc_pbr_ibl_specular(surface_data, load_env_light(i)) * surface_data.occlusion;
					}
				}
				else if (gibs::enabled())
				{
					c_auto f_avg = surface_data.f0 + (float3(1.f, 1.f, 1.f) - surface_data.f0) / 21;

					c_auto irradiance  = gibs::sample_irradiance<true, false>(gibs::load_data(), surface_data.world_pos, face_normal).xyz;
					c_auto gi_diffuse  = surface_data.c_diffuse * irradiance * pi_inv;
					ambient_light	  += (1.f - f_avg) * gi_diffuse * surface_data.occlusion;

					ambient_light += calc_pbr_gibs_specular(surface_data, irradiance) * surface_data.occlusion;
				}
				else if (gist::enabled())
				{
					c_auto f_avg = surface_data.f0 + (float3(1.f, 1.f, 1.f) - surface_data.f0) / 21;

					c_auto irradiance  = gist::sample_irradiance<true, false>(gist::load_data(), surface_data.world_pos, face_normal).xyz;
					c_auto gi_diffuse  = surface_data.c_diffuse * irradiance * pi_inv;
					ambient_light	  += (1.f - f_avg) * gi_diffuse * surface_data.occlusion;

					ambient_light += calc_pbr_gist_specular(surface_data, irradiance) * surface_data.occlusion;
				}
				else
				{
					expand(MAX_ENV_LIGHT)

					for (auto i = 0u; i < env_light_count; ++i)
					{
						ambient_light += calc_pbr_ibl(surface_data, load_env_light(i));
					}
				}

				return ambient_light;
			}
		};
	}	 // namespace detail

	namespace detail
	{
		struct rt_hit_data
		{
			uint32 rt_instance_render_data_id;
			uint16 submesh_id;
			uint16 is_back_face_and_extra;
			uint32 local_primitive_id;
			float2 barycentrics;
			float  t;
		};
	}	 // namespace detail

	template <bool trace_opaque, uint32 opaque_ray_flags, bool trace_transparent, uint32 transparent_ray_flags, bool enable_wave_inst, typename t_gi_func>
	float4
	calc_ray_color(inout t_gi_func func, out float opaque_distance, float3 origin, float3 dir /*normalized*/, float t_min = 0.f, float t_max = float_max)
	{
		rt_acceleration_structure tlas = global_resource_buffer[rt_tlas_buffer_id];

		auto res = zero<float4>();

		opaque_distance = float_max;

		do
		{
			attr_branch()
			if (trace_opaque is_false) { break; }

			auto query = ray_query<RAY_FLAG_CULL_NON_OPAQUE | opaque_ray_flags>();
			rt_trace_ray_inline(query, tlas, RAY_FLAG_NONE, RT_MASK_OPAQUE, rt::init_ray_desc(origin, dir, t_min, t_max));
			rt_proceed(query);

			attr_branch()
			if (rt_committed_status(query) == COMMITTED_NOTHING)
			{
				res = float4(calc_skybox_color(dir), 1.f);
				break;
			}

			t_max			= rt_committed_ray_t(query);
			opaque_distance = t_max;

			c_auto submesh_id	   = rt_committed_geometry_index(query);
			c_auto rt_render_data  = load_rt_instance_render_data(rt_committed_instance_id(query));
			c_auto obj_render_data = load_object_render_data(rt_render_data.object_render_id);
			c_auto is_back_face	   = rt_committed_triangle_front_face(query) is_false;
			c_auto mat			   = mesh::load_submesh_material_from_submesh_id(submesh_id, obj_render_data);

			attr_branch()
			if (is_back_face)
			{
				const bool double_sided = rt_render_data.is_force_double_sided() or mat.is_double_sided();

				if (double_sided is_false)
				{
					res				= float4(0, 0, 0, 1.f);
					opaque_distance = -t_max;
					break;
				}
			}

			c_auto msh_header	 = read_mesh_header(obj_render_data);
			c_auto surface_point = mesh::calc_surface_point(load_object_data(rt_render_data.object_render_id),
															obj_render_data,
															msh_header,
															mat,
															submesh_id,
															msh_header.calc_primitive_id(submesh_id, rt_committed_primitive_index(query)),
															rt_committed_triangle_barycentrics(query),
															is_back_face);

			c_auto surface_data = calc_pbr_surface(dir, surface_point.mat, surface_point.v);

			c_auto col = func(surface_data, surface_point.world_face_normal)
					   + calc_di<enable_wave_inst>(surface_data, surface_point.world_face_normal);

			res = float4(col, 1.f);
		}
		while (false);

		attr_branch()
		if (trace_transparent)
		{
			detail::rt_hit_data hit_data_arr[MAX_RAY_HIT] = (detail::rt_hit_data[MAX_RAY_HIT])0;
			auto				hit_count				  = 0u;

			auto query = ray_query<RAY_FLAG_CULL_OPAQUE | transparent_ray_flags>();
			rt_trace_ray_inline(query, tlas, RAY_FLAG_NONE, RT_MASK_TRANSPARENT | RT_MASK_OMM, rt::init_ray_desc(origin, dir, t_min, t_max));

			while (rt_proceed(query))
			{
				c_auto t = rt_candidate_triangle_ray_t(query);

				if (hit_count >= MAX_RAY_HIT and t >= hit_data_arr[hit_count - 1].t) { continue; }

				c_auto rt_instance_render_data_id = rt_candidate_instance_id(query);
				c_auto submesh_id				  = rt_candidate_geometry_index(query);
				c_auto local_primitive_id		  = rt_candidate_primitive_index(query);

				c_auto end = hit_count < MAX_RAY_HIT ? hit_count : hit_count - 1;
				auto   pos = end;
				auto   dup = false;

				for (auto i = 0u; i < end; ++i)
				{
					if (hit_data_arr[i].rt_instance_render_data_id == rt_instance_render_data_id
						and hit_data_arr[i].submesh_id == submesh_id
						and hit_data_arr[i].local_primitive_id == local_primitive_id)
					{
						dup = true;
						break;
					}

					if (pos == end and t < hit_data_arr[i].t)
					{
						pos = i;
					}
				}

				if (dup) { continue; }

				for (auto i = end; i > pos; --i)
				{
					hit_data_arr[i] = hit_data_arr[i - 1];
				}

				hit_data_arr[pos].t							 = t;
				hit_data_arr[pos].rt_instance_render_data_id = rt_instance_render_data_id;
				hit_data_arr[pos].submesh_id				 = cast<uint16>(submesh_id);
				hit_data_arr[pos].is_back_face_and_extra	 = cast<uint16>(rt_candidate_triangle_front_face(query) is_false);
				hit_data_arr[pos].local_primitive_id		 = local_primitive_id;
				hit_data_arr[pos].barycentrics				 = rt_candidate_triangle_barycentrics(query);

				if (hit_count < MAX_RAY_HIT)
				{
					hit_count++;
				}
			}

			float4 transparent_color = zero<float4>();

			attr_loop()
			for (auto i = 0u; i < hit_count; ++i)
			{
				c_auto hit			   = hit_data_arr[i];
				c_auto rt_render_data  = load_rt_instance_render_data(hit.rt_instance_render_data_id);
				c_auto obj_render_data = load_object_render_data(rt_render_data.object_render_id);
				c_auto msh_header	   = read_mesh_header(obj_render_data);
				c_auto is_back_face	   = hit.is_back_face_and_extra & 1u;
				c_auto mat			   = mesh::load_submesh_material_from_submesh_id(hit.submesh_id, obj_render_data);

				attr_branch()
				if (is_back_face)
				{
					const bool double_sided = rt_render_data.is_force_double_sided() or mat.is_double_sided();

					if (double_sided is_false) { continue; }
				}
				c_auto surface_point = mesh::calc_surface_point(load_object_data(rt_render_data.object_render_id),
																obj_render_data,
																msh_header,
																mat,
																hit.submesh_id,
																msh_header.calc_primitive_id(hit.submesh_id, hit.local_primitive_id),
																hit.barycentrics,
																is_back_face);

				c_auto surface_data = calc_pbr_surface(dir, surface_point.mat, surface_point.v);

				c_auto col = func(surface_data, surface_point.world_face_normal)
						   + calc_di<enable_wave_inst>(surface_data, surface_point.world_face_normal);

				c_auto rt_alpha_test_mode = mesh::calc_rt_alpha_test_mode(msh_header, hit.submesh_id, rt_render_data);

				auto alpha = rt_alpha_test_mode == AGE_RT_ALPHA_TEST_MODE_OPAQUE
							   ? 1.f
						   : rt_alpha_test_mode == AGE_RT_ALPHA_TEST_MODE_MASK
							   ? (surface_data.base_color.a >= surface_point.mat.alpha_cutoff ? 1.f : 0.f)
							   : surface_data.base_color.a;

				alpha *= rt_render_data.fade_factor();

				transparent_color.rgb += col * alpha * (1.f - transparent_color.a);
				transparent_color.a	  += alpha * (1.f - transparent_color.a);

				if (transparent_color.a >= 1.f) { break; }
			}

			res.rgb = transparent_color.rgb + res.rgb * (1.f - transparent_color.a);
			res.a	= transparent_color.a + res.a * (1.f - transparent_color.a);
		}

		return res;
	}

	template <bool trace_opaque, uint32 opaque_ray_flags, bool trace_transparent, uint32 transparent_ray_flags, bool enable_wave_inst, typename t_gi_func>
	float4
	calc_ray_color(inout t_gi_func func, float3 origin, float3 dir /*normalized*/, float t_min = 0.f, float t_max = float_max)
	{
		float _;
		return calc_ray_color<trace_opaque, opaque_ray_flags, trace_transparent, transparent_ray_flags, enable_wave_inst, t_gi_func>(func, _, origin, dir, t_min, t_max);
	}

	template <bool enable_wave_inst>
	float4
	calc_transparent_color(float3 origin, float3 dir /*normalized*/, float t_min = 0.f, float t_max = float_max)
	{
		detail::gi_func func = zero<detail::gi_func>();

		const float4 res = calc_ray_color<false, RAY_FLAG_CULL_BACK_FACING_TRIANGLES, true, RAY_FLAG_NONE, enable_wave_inst>(
			func, origin, dir, t_min, t_max);

		return res;
	}
}	 // namespace lighting
