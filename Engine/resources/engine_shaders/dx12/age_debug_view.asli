namespace debug_view
{
	bool
	is_cursor_hit(const in debug_view_data data, const in debug_view_cursor_data cursor_data)
	{
		return cursor_data.hit_layer_debug_view_kind != 0u
			or cursor_data.hit_layer_debug_overlay_flag != 0u;
	}
