#pragma once
#include "age.asli"

namespace debug_view
{
	debug_view_data
	load_data()
	{
		return load<debug_view_data>(static_buffer, DEBUG_VIEW_DATA_OFFSET);
	}

	debug_view_slot_data
	load_slot_data(const in debug_view_data data, uint32 idx)
	{
		assert(idx < data.slot_count);
		return load<debug_view_slot_data>(static_buffer, DEBUG_VIEW_SLOT_DATA_OFFSET + sizeof(debug_view_slot_data) * idx);
	}

	bool
	enabled()
	{
		return util::is_flag_set<AGE_SYSTEM_KIND_DEBUG_VIEW>(system_flags);
	}


}	 // namespace debug_view

// scratch
namespace debug_view
{
#define buffer_uav_id data.h_debug_view_scratch_buffer_uav_id
#define buffer_srv_id data.h_debug_view_scratch_buffer_srv_id
#define helper_func(type, name)                                                 \
	template <bool is_rw = false>                                               \
	type                                                                        \
	load_##name(const in debug_view_data data, uint32 idx = 0u)                 \
	{                                                                           \
		attr_branch()                                                           \
                                                                                \
		if (is_rw)                                                              \
		{                                                                       \
			rw_byte_address_buffer buf = global_resource_buffer[buffer_uav_id]; \
			return load<type>(buf, data.name##_offset() + sizeof(type) * idx);  \
		}                                                                       \
		else                                                                    \
		{                                                                       \
			byte_address_buffer buf = global_resource_buffer[buffer_srv_id];    \
			return load<type>(buf, data.name##_offset() + sizeof(type) * idx);  \
		}                                                                       \
	}                                                                           \
	void                                                                        \
	set_##name(const in debug_view_data data, type var, uint32 idx = 0u)        \
	{                                                                           \
		rw_byte_address_buffer buf = global_resource_buffer[buffer_uav_id];     \
		store(buf, data.name##_offset() + sizeof(type) * idx, var);             \
	}

	helper_func(uint32, cursor_data_count);
	helper_func(debug_view_popup_data, popup_data);
	helper_func(debug_view_cursor_data, cursor_data);
	helper_func(int32_4, slot_rect);

	debug_view_cursor_data
	load_cursor_hover_data(const in debug_view_data data)
	{
		return load_cursor_data(data, 0u);
	}

	void
	set_cursor_hover_data(const in debug_view_data data, const in debug_view_cursor_data cursor_data)
	{
		set_cursor_data(data, cursor_data, 0u);
	}

	template <typename t_type, bool is_rw = false>
	t_type
	load_cursor_scratch_data(const in debug_view_data data, uint32 idx)
	{
		attr_branch()

		if (is_rw)
		{
			rw_byte_address_buffer buf = global_resource_buffer[buffer_uav_id];
			return load<t_type>(buf, data.cursor_scratch_data_offset() + data.cursor_scratch_data_size() * idx);
		}
		else
		{
			byte_address_buffer buf = global_resource_buffer[buffer_srv_id];
			return load<t_type>(buf, data.cursor_scratch_data_offset() + data.cursor_scratch_data_size() * idx);
		}
	}

	template <typename t_type>
	void
	set_cursor_scratch_data(const in debug_view_data data, const in t_type cursor_scratch_data, uint32 idx)
	{
		rw_byte_address_buffer buf = global_resource_buffer[buffer_uav_id];
		store<t_type>(buf, data.cursor_scratch_data_offset() + data.cursor_scratch_data_size() * idx, cursor_scratch_data);
	}

#undef buffer_uav_id
#undef buffer_srv_id
#undef helper_func
}	 // namespace debug_view

namespace debug_view
{
	float2
	calc_uv_local(int32_4 rect, int32_2 px)
	{
		const int32_2 rect_size = rect.zw - rect.xy;
		return saturate(float2((px - rect.xy + 0.5f)) / float2(rect_size));
	}
}	 // namespace debug_view

