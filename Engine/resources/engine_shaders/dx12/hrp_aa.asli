#pragma once
#include "age.asli"

namespace aa
{
	aa_data
	load_data()
	{
		return load<aa_data>(static_buffer, AA_DATA_OFFSET);
	}

	bool
	enabled()
	{
		return system_flags & AGE_SYSTEM_KIND_AA;
	}

	void
	execute_ray_entry(bool is_opaque, uint32 group_id, uint32 group_thread_id)
	{
		c_auto word_per_tile = ceil(SEGMENT_TILE_SIZE * SEGMENT_TILE_SIZE, 32u);
		c_auto ept			 = AGE_WAVE_SIZE;
		c_auto epg			 = ept * AGE_WAVE_SIZE;

		c_auto extent		  = cast<uint32_2>(backbuffer_size);
		c_auto tile_extent	  = ceil(extent, SEGMENT_TILE_SIZE);
		c_auto max_word_count = tile_extent.x * tile_extent.y * word_per_tile;

		c_auto				offset		= is_opaque ? 0u : tile_extent.x * tile_extent.y * word_per_tile * sizeof(uint32);
		byte_address_buffer segment_buf = global_resource_buffer[load_segment_data().h_segment_buffer_srv_id];
		uint32				segment_tile_word_arr[ept];
		auto				edge_px_local_count = 0u;

		expand_all()
		for (auto i = 0u; i < ept; ++i)
		{
			c_auto word_idx = group_id * epg
							+ group_thread_id
							+ i * AGE_WAVE_SIZE;

			if (word_idx >= max_word_count) { break; }

			segment_tile_word_arr[i] = load<uint32>(segment_buf, offset + word_idx * sizeof(uint32));

			edge_px_local_count += countbits(segment_tile_word_arr[i]);
		}

		c_auto data = load_aa_data();

		c_auto edge_px_wave_prefix = wave_prefix_sum(edge_px_local_count);
		uint32 alloc;
		if (wave_lane_index() == AGE_WAVE_SIZE - 1)
		{
			rw_byte_address_buffer indirect_arg_buf = global_resource_buffer[data.h_indirect_arg_uav_id];

			buf_interlocked_add(indirect_arg_buf, is_opaque ? 0 : sizeof(uint32_3), edge_px_wave_prefix + edge_px_local_count, alloc);
		}

		alloc = wave_read_lane_at(alloc, AGE_WAVE_SIZE - 1);

		auto				   target_offset = alloc + edge_px_wave_prefix;
		rw_byte_address_buffer ray_entry_buf = global_resource_buffer[data.h_ray_buffer_uav_id];

		expand_all()
		for (auto i = 0u; i < ept; ++i)
		{
			c_auto word_idx = group_id * epg
							+ group_thread_id
							+ i * AGE_WAVE_SIZE;

			if (word_idx >= max_word_count) { break; }

			c_auto word_px_idx_flat = (word_idx % word_per_tile) * 32;

			c_auto tile_idx = word_idx / word_per_tile;
			c_auto tile_px	= uint16_2(tile_idx % tile_extent.x, tile_idx / tile_extent.x);

			auto segment_tile_word = segment_tile_word_arr[i];
			for (; segment_tile_word > 0; segment_tile_word &= (segment_tile_word - 1))
			{
				c_auto nth_bit		 = first_bit_low(segment_tile_word);
				c_auto local_px_flat = word_px_idx_flat + nth_bit;
				c_auto px_offset	 = uint16_2(local_px_flat % SEGMENT_TILE_SIZE, local_px_flat / SEGMENT_TILE_SIZE);
				c_auto px			 = tile_px * uint16(SEGMENT_TILE_SIZE) + px_offset;

				if (target_offset >= data.px_headroom) { return; }

				aa_ray_entry entry;
				entry.px = px;

				store(ray_entry_buf, target_offset * sizeof(aa_ray_entry), entry);
				target_offset++;
			}
		}
	}
}	 // namespace aa